#!/usr/bin/env bash
set -ue

# script to prepare and start the testcase reduction process

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

if [[ ! -d repro ]]; then
    echo "Error: repro/ directory not found."
    echo "Create it with at least main.jl and Project.toml inside."
    exit 1
fi
if [[ ! -f repro/main.jl ]]; then
    echo "Error: repro/main.jl not found."
    exit 1
fi

# list files being reduced
echo "Reducing the following sources:"
find repro -name "*.jl" -type f | sort | while read -r f; do echo "  $f"; done

case "$(uname -s)" in
    Darwin|FreeBSD|NetBSD|OpenBSD) CORES=$(sysctl -n hw.ncpu) ;;
    Linux)                         CORES=$(nproc) ;;
    *)                             CORES=1 ;;
esac

nice -n 20 cvise --timeout 60 --tidy --n "$CORES" --not-c "$@" "$DIR/run" repro
